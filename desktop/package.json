{
    "name": "jiasu-canvas",
    "version": "0.19.0",
    "private": true,
    "description": "佳速画布 desktop shell",
    "author": {
        "name": "hyc0122",
        "email": "hyc0122@users.noreply.github.com"
    },
    "desktopName": "jiasu-canvas.desktop",
    "license": "MIT",
    "homepage": "https://github.com/hyc0122/jiasu-canvas",
    "main": "electron/main.cjs",
    "scripts": {
        "build:web": "node scripts/pack.cjs web",
        "pack": "node scripts/pack.cjs",
        "pack:linux": "node scripts/pack.cjs linux",
        "pack:win": "node scripts/pack.cjs win",
        "pack:only": "node scripts/pack.cjs pack-only",
        "start": "electron .",
        "icons": "python3 scripts/generate-icons.py",
        "publish:update": "node scripts/publish-update.cjs"
    },
    "devDependencies": {
        "electron": "^37.3.0",
        "electron-builder": "^26.0.12"
    },
    "build": {
        "appId": "com.jiasuapi.jiasu-canvas",
        "productName": "佳速画布",
        "copyright": "Copyright © 佳速画布",
        "asar": true,
        "afterPack": "./scripts/after-pack.cjs",
        "directories": {
            "output": "../release",
            "buildResources": "build"
        },
        "files": [
            "electron/**/*",
            "web-dist/**/*"
        ],
        "extraMetadata": {
            "name": "jiasu-canvas",
            "main": "electron/main.cjs"
        },
        "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
        "linux": {
            "target": [
                {
                    "target": "AppImage",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "deb",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "tar.gz",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "category": "Graphics",
            "icon": "build/icon.png",
            "executableName": "jiasu-canvas",
            "maintainer": "hyc0122 <hyc0122@users.noreply.github.com>",
            "syncDesktopName": true,
            "desktop": {
                "entry": {
                    "Name": "佳速画布",
                    "Comment": "佳速画布",
                    "Categories": "Graphics;2DGraphics;RasterGraphics;"
                }
            }
        },
        "deb": {
            "packageName": "jiasu-canvas"
        },
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "portable",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "build/icon.ico",
            "executableName": "jiasu-canvas",
            "signAndEditExecutable": false
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "佳速画布",
            "installerLanguages": [
                "zh_CN",
                "en_US"
            ],
            "artifactName": "${name}-${version}-win-${arch}-setup.${ext}"
        },
        "portable": {
            "artifactName": "${name}-${version}-win-${arch}-portable.${ext}"
        }
    }
}
